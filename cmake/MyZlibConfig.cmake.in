get_filename_component(MYZLIB_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)

include(CMakeFindDependencyMacro)

# NOTE Had to use find_package because find_dependency does not support COMPONENTS or MODULE until 3.8.0


if(NOT TARGET MyZlib::MyZlib)
    include("${MYZLIB_CMAKE_DIR}/MyZlibTargets.cmake")
endif()


set(MYZLIB_LIBRARIES MyZlib::MyZlib)
